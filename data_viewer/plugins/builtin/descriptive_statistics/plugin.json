{
  "schema_version": 1,
  "api_version": 1,
  "id": "org.dataviewer.descriptive_statistics",
  "name": "Descriptive Statistics",
  "version": "1.0.0",
  "description": "Computes count, missingness, mean, standard deviation, quantiles, and extrema.",
  "entry_point": "data_viewer.plugins.builtin.dataset_profile.plugin:DescriptiveStatisticsPlugin",
  "kind": "analysis",
  "required_dependencies": [],
  "input": {
    "domains": ["array", "volume"],
    "min_ndim": 1,
    "max_ndim": null,
    "dtype_families": ["boolean", "integer", "floating", "complex"],
    "requires_random_access": false,
    "supports_chunked_input": true,
    "supports_selection": true
  },
  "parameters_schema": {
    "type": "object",
    "properties": {
      "axis": {
        "type": "integer",
        "minimum": -1,
        "default": -1,
        "title": "Axis",
        "description": "-1 flattens the input; non-negative values reduce that axis."
      },
      "nan_policy": {
        "type": "string",
        "enum": ["omit", "propagate"],
        "default": "omit",
        "title": "NaN policy"
      },
      "quantile_low": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.25,
        "title": "Lower quantile"
      },
      "quantile_high": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "default": 0.75,
        "title": "Upper quantile"
      }
    },
    "additionalProperties": false
  },
  "result_kinds": ["table"]
}
